# === Application ===
APP_NAME=Agente01 - Relatório Técnico Automatizado
APP_ENV=DEV
DEBUG=true
API_PREFIX=/api/v1

# === Database ===
DATABASE_URL=postgresql+asyncpg://agente01:agente01pass@postgres:5432/agente01
DATABASE_URL_SYNC=postgresql://agente01:agente01pass@postgres:5432/agente01

# === JWT (TROQUE EM PRODUÇÃO!) ===
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_STRONG_KEY
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=1440

# === Redis / Celery ===
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# === MinIO / S3 ===
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=agente01-evidencias
MINIO_USE_SSL=false

# === LLM Provider (openai | claude | local) ===
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514
LOCAL_LLM_URL=

# === Digital Signature ===
SIGNING_PRIVATE_KEY_PATH=
SIGNING_PRIVATE_KEY_PEM=

# === Upload Limits ===
MAX_UPLOAD_SIZE_MB=100
ALLOWED_IMAGE_EXTENSIONS=.jpg,.jpeg,.png,.bmp,.tiff,.gif
ALLOWED_VIDEO_EXTENSIONS=.mp4,.avi,.mov,.mkv,.wmv

# === LGPD ===
DATA_RETENTION_DAYS=1825
PURGE_REQUIRES_ADMIN=true

# === LibreOffice ===
LIBREOFFICE_PATH=libreoffice
